{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "claude": "#D77757",

    "textDark": "#FFFFFF",
    "inactiveDark": "#999999",
    "subtleDark": "#505050",
    "promptBorderDark": "#888888",
    "userMessageBgDark": "#373737",
    "suggestionDark": "#B1B9F9",
    "planModeDark": "#48968C",
    "ideDark": "#4782C8",
    "successDark": "#4EBA65",
    "errorDark": "#FF6B80",
    "warningDark": "#FFC107",
    "diffAddedDark": "#225C2B",
    "diffRemovedDark": "#7A2936",
    "diffAddedDimmedDark": "#47584A",
    "diffRemovedDimmedDark": "#69484D",
    "diffAddedWordDark": "#38A660",
    "diffRemovedWordDark": "#B3596B",

    "textLight": "#000000",
    "inactiveLight": "#666666",
    "subtleLight": "#AFAFAF",
    "promptBorderLight": "#999999",
    "userMessageBgLight": "#F0F0F0",
    "suggestionLight": "#5769F7",
    "planModeLight": "#006666",
    "ideLight": "#4782C8",
    "successLight": "#2C7A39",
    "errorLight": "#AB2B3F",
    "warningLight": "#966C1E",
    "diffAddedLight": "#69DB7C",
    "diffRemovedLight": "#FFA8B4",
    "diffAddedDimmedLight": "#C7E1CB",
    "diffRemovedDimmedLight": "#FDD2D8",
    "diffAddedWordLight": "#2F9D44",
    "diffRemovedWordLight": "#D1454B",

    "monokaiComment": "#75715E",
    "monokaiPink": "#F92672",
    "monokaiGreen": "#A6E22E",
    "monokaiYellow": "#E6DB74",
    "monokaiPurple": "#AE81FF",
    "monokaiBlue": "#66D9EF",
    "monokaiText": "#F8F8F2",

    "githubComment": "#6A737D",
    "githubRed": "#D73A49",
    "githubPurple": "#6F42C1",
    "githubNavy": "#032F62",
    "githubBlue": "#005CC5",
    "githubText": "#24292E"
  },
  "theme": {
    "primary": "claude",
    "secondary": { "dark": "suggestionDark", "light": "suggestionLight" },
    "accent": { "dark": "planModeDark", "light": "planModeLight" },
    "error": { "dark": "errorDark", "light": "errorLight" },
    "warning": { "dark": "warningDark", "light": "warningLight" },
    "success": { "dark": "successDark", "light": "successLight" },
    "info": { "dark": "ideDark", "light": "ideLight" },
    "text": { "dark": "textDark", "light": "textLight" },
    "textMuted": { "dark": "inactiveDark", "light": "inactiveLight" },
    "selectedListItemText": { "dark": "#000000", "light": "#FFFFFF" },
    "background": "none",
    "backgroundPanel": { "dark": "userMessageBgDark", "light": "userMessageBgLight" },
    "backgroundElement": "none",
    "backgroundMenu": { "dark": "userMessageBgDark", "light": "userMessageBgLight" },
    "border": { "dark": "promptBorderDark", "light": "promptBorderLight" },
    "borderActive": "claude",
    "borderSubtle": { "dark": "subtleDark", "light": "subtleLight" },

    "diffAdded": { "dark": "successDark", "light": "successLight" },
    "diffRemoved": { "dark": "errorDark", "light": "errorLight" },
    "diffContext": { "dark": "inactiveDark", "light": "inactiveLight" },
    "diffHunkHeader": { "dark": "inactiveDark", "light": "inactiveLight" },
    "diffHighlightAdded": { "dark": "diffAddedWordDark", "light": "diffAddedWordLight" },
    "diffHighlightRemoved": { "dark": "diffRemovedWordDark", "light": "diffRemovedWordLight" },
    "diffAddedBg": { "dark": "diffAddedDark", "light": "diffAddedLight" },
    "diffRemovedBg": { "dark": "diffRemovedDark", "light": "diffRemovedLight" },
    "diffContextBg": "none",
    "diffLineNumber": { "dark": "inactiveDark", "light": "inactiveLight" },
    "diffAddedLineNumberBg": { "dark": "diffAddedDimmedDark", "light": "diffAddedDimmedLight" },
    "diffRemovedLineNumberBg": { "dark": "diffRemovedDimmedDark", "light": "diffRemovedDimmedLight" },

    "markdownText": { "dark": "textDark", "light": "textLight" },
    "markdownHeading": { "dark": "textDark", "light": "textLight" },
    "markdownLink": { "dark": "suggestionDark", "light": "suggestionLight" },
    "markdownLinkText": { "dark": "suggestionDark", "light": "suggestionLight" },
    "markdownCode": { "dark": "suggestionDark", "light": "suggestionLight" },
    "markdownBlockQuote": { "dark": "inactiveDark", "light": "inactiveLight" },
    "markdownEmph": { "dark": "textDark", "light": "textLight" },
    "markdownStrong": { "dark": "textDark", "light": "textLight" },
    "markdownHorizontalRule": { "dark": "subtleDark", "light": "subtleLight" },
    "markdownListItem": { "dark": "textDark", "light": "textLight" },
    "markdownListEnumeration": { "dark": "textDark", "light": "textLight" },
    "markdownImage": { "dark": "suggestionDark", "light": "suggestionLight" },
    "markdownImageText": { "dark": "inactiveDark", "light": "inactiveLight" },
    "markdownCodeBlock": { "dark": "textDark", "light": "textLight" },

    "syntaxComment": { "dark": "monokaiComment", "light": "githubComment" },
    "syntaxKeyword": { "dark": "monokaiPink", "light": "githubRed" },
    "syntaxFunction": { "dark": "monokaiGreen", "light": "githubPurple" },
    "syntaxVariable": { "dark": "monokaiText", "light": "githubText" },
    "syntaxString": { "dark": "monokaiYellow", "light": "githubNavy" },
    "syntaxNumber": { "dark": "monokaiPurple", "light": "githubBlue" },
    "syntaxType": { "dark": "monokaiBlue", "light": "githubBlue" },
    "syntaxOperator": { "dark": "monokaiPink", "light": "githubRed" },
    "syntaxPunctuation": { "dark": "monokaiText", "light": "githubText" },

    "thinkingOpacity": 0.55
  }
}
